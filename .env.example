# .env.example — copy to .env and adjust values as needed.
# docker-compose.yml reads this file automatically (docker compose looks for `.env`
# in the same directory as the compose file). No secrets are committed here.

# --- MongoDB (Docker Compose service) ---
# Credentials for the MongoDB container itself. Change these for any non-local use.
MONGO_INITDB_ROOT_USERNAME=campusly
MONGO_INITDB_ROOT_PASSWORD=change-me

# --- Event Service ---
EVENT_SERVICE_PORT=4300
# Backend containers reach MongoDB via the Compose service name "mongodb", not localhost.
EVENT_SERVICE_MONGODB_URI=mongodb://campusly:change-me@mongodb:27017
EVENT_SERVICE_MONGODB_DB_NAME=event_db

# --- Registration Service ---
REGISTRATION_SERVICE_PORT=4100
REGISTRATION_SERVICE_MONGODB_URI=mongodb://campusly:change-me@mongodb:27017
REGISTRATION_SERVICE_MONGODB_DB_NAME=registration_db
# Registration Service calls Event Service by its Compose service name internally.
REGISTRATION_EVENT_SERVICE_URL=http://event-service:4300

# --- Frontend (TanStack Start SSR app) ---
FRONTEND_PORT=3000
# These are consumed by the BROWSER (client-side fetch calls), so they must be
# URLs reachable from the host machine — i.e. the *published* ports below —
# not the internal Docker service names.
VITE_REGISTRATION_SERVICE_URL=http://localhost:4100
VITE_EVENT_SERVICE_URL=http://localhost:4300
